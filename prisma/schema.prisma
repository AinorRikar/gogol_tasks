generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DEVELOPER
  CLIENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  SUPPORTED
  PLANNING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  passwordHash    String          @default("")
  role            UserRole
  createdProjects Project[]       @relation("ProjectCreator")
  memberships     ProjectMember[]
  sentMessages    ChatMessage[]   @relation("MessageAuthor")
  tasks           ProjectTask[]   @relation("TaskAssignee")
  uploadedImages  ProjectImage[]  @relation("ImageUploader")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Project {
  id          Int             @id @default(autoincrement())
  title       String
  description String
  status      ProjectStatus
  visibility  Boolean         @default(true)
  hidden      Boolean         @default(false)
  archivedAt  DateTime?
  members     ProjectMember[]
  messages    ChatMessage[]
  tasks       ProjectTask[]
  images      ProjectImage[]
  createdById Int
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  projectId Int
  authorId  Int
  text      String
  sentAt    DateTime?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProjectTask {
  id          Int        @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  Int?
  order       Int        @default(0)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ProjectImage {
  id           Int      @id @default(autoincrement())
  projectId    Int
  uploadedById Int
  fileName     String
  fileUrl      String
  mimeType     String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("ImageUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}
