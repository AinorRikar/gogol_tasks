DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:3000"
# Префикс приложения: локально не задавайте или "/"; в Docker за nginx — "/dashboard/"
# NUXT_PUBLIC_APP_BASEURL="/dashboard/"
# Каталог загрузок (в Docker compose: /data/uploads, том gogol-uploads)
# UPLOADS_DIR="/data/uploads"
# Публичный origin для URL картинок в API (без /dashboard). Нужен, если integration дергают из Docker-сети.
# PUBLIC_APP_ORIGIN="http://ВАШ_ПУБЛИЧНЫЙ_IP"
# Общий секрет с внешним сайтом для GET /api/integration/* (JWT HS256, до 3 мин). См. API.md
# INTEGRATION_SECRET="change-me-integration-secret"
